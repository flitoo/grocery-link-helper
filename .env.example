# Copy to backend/.env and fill in your local PostgreSQL credentials.

# Option A - single connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/grocery_link

# Option B - discrete variables (used only when DATABASE_URL is unset)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=grocery_link

# Express
PORT=8080
# CORS_ORIGIN=http://localhost:3000   # optional: pin one origin. Unset = any localhost port
