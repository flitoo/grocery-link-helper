{
  "name": "grocery-link-helper-backend",
  "version": "1.0.0",
  "description": "Express API backend for Grocery Link Helper",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up --migrations-dir ../database/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir ../database/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir ../database/migrations --migration-file-language sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
