PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/grocery_link_helper
JWT_SECRET=replace_with_a_long_random_secret

# Delivery slots (all optional). Capacity per slot defaults to the number of
# Helper users; set SLOT_CAPACITY to override (needed while no helpers exist).
# SLOT_CAPACITY=3
# SLOT_TIMEZONE=America/Toronto
# SLOT_OPEN_HOUR=8
# SLOT_CLOSE_HOUR=21
# SLOT_LEAD_HOURS=2
