PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/grocery_link_helper
JWT_SECRET=replace_with_a_long_random_secret

# Local demo only (ignored when NODE_ENV=production)
ENABLE_DEMO_PAYMENTS=true
ENABLE_DEMO_HELPER_REGISTRATION=true

# Orders per delivery slot. Defaults to the number of helper accounts, so with no
# helpers every slot shows as full. Set this for demos or an empty database.
# SLOT_CAPACITY=2

# Minutes before an unpaid order is cancelled automatically (default 30).
# ORDER_PAYMENT_TIMEOUT_MINUTES=30
